# SiliconPulse AI — environment template
# Copy to .env for local development. Never commit real secrets.
# Demo credentials below are DEVELOPMENT-ONLY and not production-safe.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=SiliconPulse AI
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost

# -----------------------------------------------------------------------------
# Auth (development only)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Demo users are seeded in later phases — replace immediately outside local demos
DEMO_ADMIN_EMAIL=admin@siliconpulse.local
DEMO_ADMIN_PASSWORD=ChangeMeAdmin!
DEMO_OPERATOR_EMAIL=operator@siliconpulse.local
DEMO_OPERATOR_PASSWORD=ChangeMeOperator!
DEMO_ENGINEER_EMAIL=engineer@siliconpulse.local
DEMO_ENGINEER_PASSWORD=ChangeMeEngineer!
DEMO_VIEWER_EMAIL=viewer@siliconpulse.local
DEMO_VIEWER_PASSWORD=ChangeMeViewer!

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=siliconpulse
POSTGRES_USER=siliconpulse
POSTGRES_PASSWORD=siliconpulse_dev_password
DATABASE_URL=postgresql+psycopg://siliconpulse:siliconpulse_dev_password@postgres:5432/siliconpulse

# -----------------------------------------------------------------------------
# Valkey
# -----------------------------------------------------------------------------
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_URL=redis://valkey:6379/0

# -----------------------------------------------------------------------------
# Redpanda
# -----------------------------------------------------------------------------
REDPANDA_BROKERS=redpanda:9092
REDPANDA_SCHEMA_REGISTRY_URL=http://redpanda:8081
REDPANDA_CONSOLE_URL=http://localhost:8080
REDPANDA_CONSOLE_PORT=8080
# Host Kafka advertise port for local producers outside Compose network
REDPANDA_KAFKA_EXTERNAL_PORT=19092

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_password
MINIO_USE_SSL=false
MINIO_BUCKET_RAW_TELEMETRY=raw-telemetry
MINIO_BUCKET_PROCESSED_TELEMETRY=processed-telemetry
MINIO_BUCKET_TRAINING=training-datasets
MINIO_BUCKET_MODELS=ml-models
MINIO_BUCKET_EVAL=evaluation-reports
MINIO_BUCKET_REPORTS=incident-reports
MINIO_BUCKET_FIRMWARE=firmware-artifacts
MINIO_BUCKET_EXPORTS=exports

# -----------------------------------------------------------------------------
# Telemetry simulator
# -----------------------------------------------------------------------------
SIM_DEVICE_COUNT=50
SIM_RACK_COUNT=5
SIM_EMIT_INTERVAL_MS=1000
SIM_SEED=42
SIM_SPEED_MULTIPLIER=1.0
SIM_DEFAULT_DEVICE_ID=GPU-042
SIM_PUBLISH_ENABLED=true
SIM_CONTROL_PORT=8100
# Inside Compose use redpanda:9092; on host use localhost:19092
# REDPANDA_BROKERS=localhost:19092

# -----------------------------------------------------------------------------
# Ollama (local generative AI)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_FALLBACK_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_ENABLED=true

# -----------------------------------------------------------------------------
# MLflow
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=siliconpulse-default

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=siliconpulse-api
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_password

# -----------------------------------------------------------------------------
# Feature flags / safety
# -----------------------------------------------------------------------------
HEALTHCARE_MODULE_ENABLED=true
REQUIRE_APPROVAL_FOR_ACTIONS=true
ALLOW_SCENARIO_INJECTION=true
